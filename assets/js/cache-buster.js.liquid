// 캐시 버스팅을 위한 클라이언트 사이드 스크립트 (강화된 버전)
(function() {
  // 마지막 방문 시간 저장 키
  const LAST_VISIT_KEY = 'site_last_visit';
  // 현재 사이트 버전 (Jekyll에서 주입)
  const SITE_VERSION = '{{ site.site_version }}';
  // 현재 빌드 타임스탬프 (Jekyll에서 주입)
  const BUILD_TIME = '{{ site.time | date: "%Y%m%d%H%M%S" }}';
  // 마지막으로 확인한 사이트 버전
  const LAST_VERSION_KEY = 'site_version';
  // 마지막 빌드 타임스탬프 키
  const LAST_BUILD_TIME_KEY = 'site_build_time';
  // 확인 간격 (30분 = 1800000 밀리초) - 더 짧게 설정
  const CHECK_INTERVAL = 1800000;
  
  // 현재 시간
  const now = new Date().getTime();
  
  try {
    // 저장된 정보 가져오기
    const lastVisit = localStorage.getItem(LAST_VISIT_KEY) || 0;
    const lastVersion = localStorage.getItem(LAST_VERSION_KEY) || '';
    const lastBuildTime = localStorage.getItem(LAST_BUILD_TIME_KEY) || '';
    
    // 현재 방문 시간 저장
    localStorage.setItem(LAST_VISIT_KEY, now);
    
    // 강제 새로고침 함수 - 특히 모바일에 효과적인 방식
    function forceRefresh() {
      // 현재 버전 저장
      localStorage.setItem(LAST_VERSION_KEY, SITE_VERSION);
      localStorage.setItem(LAST_BUILD_TIME_KEY, BUILD_TIME);
      
      // 모바일 디바이스 확인
      const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
      
      if (isMobile) {
        // 모바일 브라우저에서 더 강력한 새로고침 방식
        console.log('모바일 기기 감지: 강력한 새로고침 실행');
        // 히스토리 교체 + 캐시 무시 플래그로 새로고침
        window.location.replace(
          window.location.href.split('?')[0] + 
          '?t=' + now + 
          '&v=' + SITE_VERSION
        );
      } else {
        // 데스크톱 브라우저를 위한 표준 방식
        const reloadUrl = window.location.href.split('?')[0] + 
          '?t=' + now + 
          '&v=' + SITE_VERSION;
        
        window.location.replace(reloadUrl);
      }
    }
    
    // 디버그 정보
    console.log('Cache-buster: 현재 버전=' + SITE_VERSION + 
                ', 저장된 버전=' + lastVersion + 
                ', 빌드 시간=' + BUILD_TIME + 
                ', 저장된 빌드 시간=' + lastBuildTime);
    
    // 버전 또는 빌드 시간이 다르거나 마지막 방문 후 일정 시간이 지났으면 페이지 새로고침
    const shouldRefresh = 
      lastVersion !== SITE_VERSION || 
      lastBuildTime !== BUILD_TIME || 
      (now - parseInt(lastVisit, 10) > CHECK_INTERVAL);
    
    if (shouldRefresh) {
      console.log('Cache-buster: 새로고침 필요 - 이유: ' + 
                 (lastVersion !== SITE_VERSION ? '버전 변경' : 
                  lastBuildTime !== BUILD_TIME ? '빌드 시간 변경' : '시간 경과'));
      
      // 문서가 이미 로드되었으면 바로 새로고침, 아니면 로드 이벤트 후 실행
      if (document.readyState === 'complete') {
        forceRefresh();
      } else {
        window.addEventListener('load', forceRefresh);
      }
    }
    
    // 세션 간 캐시를 무효화하기 위한 추가 조치
    window.addEventListener('beforeunload', function() {
      // 페이지를 떠날 때 세션 스토리지의 버전 정보 초기화
      sessionStorage.setItem('page_needs_refresh', 'true');
    });
    
    // 페이지 로드 시, 세션 스토리지에서 새로고침 필요 여부 확인
    if (sessionStorage.getItem('page_needs_refresh') === 'true') {
      sessionStorage.removeItem('page_needs_refresh');
      // 페이지가 캐시에서 로드된 경우에만 새로고침
      if (performance.navigation.type !== 1) {
        forceRefresh();
      }
    }
  } catch (err) {
    console.error('캐시 버스팅 오류:', err);
  }
})(); 